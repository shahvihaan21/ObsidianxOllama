# Obsidian Control — optional environment overrides
# Copy to .env and fill in. Environment variables beat backend/config.json.

# Absolute path to your Obsidian vault (required).
VAULT_PATH=C:\Users\You\Documents\MyVault

# Local Ollama model used for summaries, note transformations and research.
LLM_MODEL=qwen3:1.7b
LLM_HOST=http://127.0.0.1:11434

# Voice input (needs sounddevice + faster-whisper).
VOICE_ENABLED=true
VOICE_STT_MODEL=tiny

# Note-centric web research.
RESEARCH_ENABLED=true
RESEARCH_MAX_SOURCES=5

# Backend server.
SERVER_HOST=127.0.0.1
SERVER_PORT=8765