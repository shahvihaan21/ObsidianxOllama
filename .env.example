# Local AI Assistant — environment variable overrides
# Copy this file to .env and fill in your values.
# Environment variables override config.json values.

# Ollama server address (default: http://127.0.0.1:11434)
OLLAMA_HOST=http://127.0.0.1:11434

# Model to use. Run `ollama list` to see installed models.
OLLAMA_MODEL=qwen3:1.7b

# Obsidian vault path (leave empty to skip Obsidian integration)
# Example: C:\Users\Vihaan\Documents\MyVault
VAULT_PATH=

# Voice input/output (true/false)
VOICE_ENABLED=true
TTS_ENABLED=true
